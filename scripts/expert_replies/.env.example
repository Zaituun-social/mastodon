# Copy this file to .env and fill in real values. .env itself is gitignored.

# Base URL of the instance, no trailing slash.
MASTODON_BASE_URL=https://your-instance.example

# Must match the server's ENV['INTERNAL_API_TOKEN'] exactly.
INTERNAL_API_TOKEN=

# Real, DNS-resolvable inbox you control. Fake accounts get
# you+<username>@gmail.com so signup's live MX check passes, and every
# confirmation/notification still lands in this one inbox.
EMAIL_ALIAS_BASE=you@gmail.com

# Optional overrides -- defaults shown.
# ACCOUNTS_PER_INTEREST=2
# PAGES_PER_TAG=2
# PAGE_LIMIT=20
# DUPLICATE_THRESHOLD=0.85
# INTERESTS_FILE=./data/interests.json
# EXPERT_REPLIES_DATA_DIR=./data
