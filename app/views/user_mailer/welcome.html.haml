= content_for :heading do
  .email-desktop-flex
    .email-header-left
      = render 'application/mailer/heading',
               subtitle: t('user_mailer.welcome.explanation'),
               title: t('user_mailer.welcome.title', name: @resource.account.username)
    .email-header-right
      .email-header-card
        %table.email-header-card-table{ cellspacing: 0, cellpadding: 0, border: 0, role: 'presentation' }
          %tr
            %td
              %table.email-w-full{ cellspacing: 0, cellpadding: 0, border: 0, role: 'presentation' }
                %tr
                  %td.email-header-card-banner-td{ background: full_asset_url(instance_presenter.thumbnail&.file&.url(:'@1x') || frontend_asset_path('images/previe.png')) }
              %table.email-w-full{ cellspacing: 0, cellpadding: 0, border: 0, role: 'presentation' }
                %tr
                  %td.email-header-card-body-td
                    %p.email-header-card-instance= @instance
                    - if instance_presenter.description.present?
                      %p.email-header-card-description= instance_presenter.description
                    = render 'application/mailer/button', text: t('user_mailer.welcome.sign_in_action'), url: new_user_session_url, has_arrow: false

%table.email-w-full{ cellspacing: 0, cellpadding: 0, border: 0, role: 'presentation' }
  %tr
    %td.email-body-huge-padding-td
      %h2.email-h2= t('user_mailer.welcome.checklist_title')
      %p.email-h-sub= t('user_mailer.welcome.checklist_subtitle')
      = render 'application/mailer/checklist', key: 'follow', checked: @has_active_relationships, button_text: t('user_mailer.welcome.follow_action'), button_url: 'co.com.zai.oauth://callback/'
      = render 'application/mailer/checklist', key: 'post', checked: @has_statuses, button_text: t('user_mailer.welcome.post_action'), button_url: 'co.com.zai.oauth://callback/'
      = render 'application/mailer/checklist', key: 'share', checked: false, button_text: t('user_mailer.welcome.share_action'), button_url: 'co.com.zai.oauth://callback/'
